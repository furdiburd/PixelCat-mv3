{
  "manifest_version": 3,
  "name": "PixelCat",
  "version": "2.6.7",
  "description": "Adds a playful pixel pet companion to your browser with animations, coins, fish, spiders, quests, achievements, and unlockable extras.",
  "permissions": [
    "storage",
    "scripting"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "icons": {
    "48": "assets/icons/icon48.png",
    "96": "assets/icons/icon96.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/owner-gate.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/icons/*.png",
        "assets/animations/*.png",
        "assets/animations/frog/*.png",
        "assets/animations/*.gif",
        "assets/fishes/*.png",
        "assets/balls/*.png",
        "assets/Cursor/light/*.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "action": {
    "default_popup": "ui/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "96": "assets/icons/icon96.png"
    }
  },
  "host_permissions": [
    "<all_urls>"
  ]
}
